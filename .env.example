# Copy to .env.local and fill in from the Supabase dashboard (Connect dialog / Settings → API Keys).
# These values are public: Vite inlines VITE_* into the browser bundle. RLS is the security boundary.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-only. Never prefix with VITE_ and never import this into src/.
# SUPABASE_SECRET_KEY=sb_secret_xxx
